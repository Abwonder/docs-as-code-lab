{
  "name": "docs-as-code-lab",
  "version": "1.0.0",
  "private": true,
  "description": "A Docusaurus documentation and CI deployment portfolio lab with a tested incident API example",
  "scripts": {
    "start": "docusaurus start --host 127.0.0.1",
    "build": "docusaurus build",
    "serve": "docusaurus serve --host 127.0.0.1",
    "clear": "docusaurus clear",
    "test": "node --test examples/api.test.mjs",
    "check:site": "node scripts/check-site.mjs",
    "verify": "npm test && npm run build && npm run check:site",
    "demo": "node examples/api.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "tinypool": "2.2.0",
    "serialize-javascript": "7.1.2",
    "postcss-selector-parser": "7.1.6",
    "uuid": "11.1.1"
  }
}
